meta {
  name: Get Checkin History
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/checkins
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: isDefined
}

docs {
  Histórico de check-ins do paciente autenticado.

  Rate limit: 100/minuto.
}
