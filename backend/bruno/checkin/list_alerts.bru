meta {
  name: List Alerts
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/alerts?patient_id={{patientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: isDefined
}

docs {
  Lista alertas. Paciente: próprios alertas (sem query).
  Profissional: exige patient_id; mesma unidade de saúde.

  Rate limit: 100/minuto.
}
