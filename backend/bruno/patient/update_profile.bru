meta {
  name: Update Patient Profile
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/v1/patients/me
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "neighborhood": "Centro",
    "city": "São Paulo",
    "state": "SP"
  }
}

assert {
  res.status: eq 200
  res.body.neighborhood: eq "Centro"
}
