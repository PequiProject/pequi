meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "paciente@test.com",
    "password": "secretpassword",
    "full_name": "João Paciente"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
}

assert {
  res.status: eq 201
  res.body.email: eq "paciente@test.com"
}
