meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "test@example.com",
    "password": "strongpassword123"
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
  res.body.refresh_token: isDefined
  res.body.user: isDefined
}
