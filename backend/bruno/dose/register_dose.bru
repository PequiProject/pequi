meta {
  name: Register Dose (v1)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/treatments/{{treatmentId}}/doses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "drug_name": "Dapsona",
    "expected_at": "2026-02-15T08:00:00Z",
    "taken_at": "2026-02-15T08:30:00Z",
    "skipped": false,
    "supervised": false
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.treatment_id: eq "{{treatmentId}}"
  res.body.drug_name: eq "Dapsona"
  res.body.supervised: eq false
}

docs {
  Contrato legado v1 — paciente ou profissional.
  Preferir v2 para fluxo patient-first.
}
