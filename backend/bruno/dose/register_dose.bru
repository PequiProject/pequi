meta {
  name: Register Dose
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/treatments/{{treatmentId}}/doses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "drug_name": "Dapsona",
    "expected_at": "2026-02-15T08:00:00Z",
    "taken_at": "2026-02-15T08:30:00Z",
    "skipped": false
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.treatment_id: eq "{{treatmentId}}"
  res.body.drug_name: eq "Dapsona"
}

docs {
  Registra uma dose (tomada ou pulada) no tratamento ativo do paciente.

  - Paciente autenticado registra doses do próprio tratamento ativo.
  - Doses diárias e mensais seguem o mesmo contrato.
  - Duplicidade (treatment_id + drug_name + expected_at) retorna HTTP 409.

  Rate limit: 20/minuto por paciente.
}
