meta {
  name: Change Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/account/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "{{currentPassword}}",
    "new_password": "{{newPassword}}",
    "confirm_password": "{{newPassword}}"
  }
}

assert {
  res.status: eq 204
}
