meta {
  name: Record Consent
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/account/consent
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  User-Agent: PequiApp/1.0
}

body:json {
  {
    "term_version": "v1.2",
    "accepted": true
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.term_version: eq v1.2
  res.body.accepted_at: isDefined
}
