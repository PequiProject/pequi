meta {
  name: Get Treatment
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/treatments/{{treatmentId}}
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.id: eq "{{treatmentId}}"
  res.body.patient_id: isDefined
  res.body.regimen: isDefined
  res.body.status: isDefined
  res.body.start_date: isDefined
  res.body.expected_end: isDefined
}

docs {
  Retorna os dados de um tratamento pelo ID.

  Acessível por:
  - Paciente: somente o próprio tratamento.
  - Profissional: somente tratamentos de pacientes da mesma unidade.

  Rate limit: 100/minuto.
}
