# ── Aplicação ─────────────────────────────────────────────────────────────────
ENV=development                          # development | staging | production
SECRET_KEY=change-me-in-production       # chave aleatória de 64+ caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Banco de dados ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pequi:pequi@localhost:5432/pequi
DATABASE_URL_TEST=postgresql+asyncpg://pequi:pequi@localhost:5432/pequi_test

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO / Cloudflare R2) ─────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_IMAGES=pequi-images
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000  # URL pública (pode diferir do endpoint interno)

# ── WhatsApp ───────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio                 # twilio | evolution
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Sentry ─────────────────────────────────────────────────────────────────────
SENTRY_DSN=                              # vazio em development/test
