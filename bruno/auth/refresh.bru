meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "your_refresh_token_here"
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
  res.body.refresh_token: isDefined
  res.body.expires_in: isDefined
}
